# ---------------------------------------------------------------
# HPAD Travel — environment variables
# Copy to .env.local for local development, and add the same keys
# in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_…) or legacy anon key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. The secret key (sb_secret_…) or legacy service_role key.
# Used only to create/deactivate logins and by the scripts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public URL of the app, used in password-reset emails (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: scripts only -------------------------------------
# npm run create-super-admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMPLOYEE_ID=
SUPER_ADMIN_PASSWORD=

# npm run demo:seed  (development project only)
SEED_DEMO=no
DEMO_PASSWORD=HpadDemo@2026
